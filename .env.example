# Copy this file to .env and fill it in. NEVER commit .env.

# --- Canvas (choose ONE) ---------------------------------------------------
# Option A: Calendar feed (works even if your school blocks API tokens)
#   Canvas -> Calendar -> "Calendar Feed" (bottom right). Keep this link private.
CANVAS_ICS_URL=

# Option B: API token (richer: announcements + hides submitted work automatically)
#   Canvas -> Account -> Settings -> "+ New Access Token"
CANVAS_API_URL=
CANVAS_API_TOKEN=

# --- Gmail (personal @gmail.com; school accounts usually block app passwords) ---
#   App password: https://myaccount.google.com/apppasswords (needs 2-Step Verification)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Where to deliver the digest (blank = GMAIL_ADDRESS)
DIGEST_TO=

# --- Settings ----------------------------------------------------------------
TIMEZONE=America/New_York
LOOKAHEAD_DAYS=7
ANNOUNCEMENT_LOOKBACK_HOURS=24
